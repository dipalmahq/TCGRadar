# Run: python scripts/setup_env.py (creates .env without printing secrets).
# PostgreSQL password: hexadecimal/alphanumeric to avoid URL-encoding issues.
POSTGRES_PASSWORD=GENERATE_A_RANDOM_DATABASE_PASSWORD
RADAR_API_KEY=GENERATE_A_RANDOM_TEAM_KEY
RADAR_ENVIRONMENT=production
RADAR_NOTIFICATIONS_ENABLED=false
RADAR_DISCORD_WEBHOOK_URL=
RADAR_TELEGRAM_BOT_TOKEN=
RADAR_TELEGRAM_CHAT_ID=
RADAR_USER_AGENT=JoyBoyzTCGRadar/0.1 (private TCG availability monitor)
RADAR_REQUEST_DELAY_SECONDS=2
RADAR_STALE_AFTER_MINUTES=30
RADAR_HISTORY_RETENTION_DAYS=90
# Default bind is local only. Use a reverse proxy for Ubuntu production.
RADAR_BIND_ADDRESS=127.0.0.1
RADAR_PORT=8000
